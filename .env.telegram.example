# Merge privately into .env; do not overwrite an existing private configuration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=
# Optional HTTP(S) proxy for Telegram only; does not configure the store browser.
TELEGRAM_PROXY_URL=
DRY_RUN=true
LIVE_CHECKOUT_APPROVED=false
TARGET_PRODUCT="Perfect (R14) KB27"
TARGET_SIZE=185/65R14
TARGET_QUANTITY=2
HEADLESS=false
# Empty: Playwright Chromium. Use chrome for an existing Google Chrome install.
BROWSER_CHANNEL=
# Store browser connects directly; TELEGRAM_PROXY_URL remains Telegram-only.
BROWSER_DIRECT_CONNECTION=true
USER_DATA_DIR=./data/telegram_profile
MAX_RETRIES=3
TIMEOUT_MS=15000
GATEWAY_HOSTS=shaparak.ir
SALE_TIMEZONE=Asia/Tehran
SALE_START_TIME=08:00:00
POLL_WINDOW_1_END=08:05:00
POLL_WINDOW_1_INTERVAL=5
POLL_WINDOW_2_END=08:10:00
POLL_WINDOW_2_INTERVAL=15
POLL_WINDOW_3_END=08:15:00
POLL_WINDOW_3_INTERVAL=30
LOGIN_REMINDER_TIME=07:55:00
DELETE_SENSITIVE_MESSAGES=true
DEBUG_ARTIFACTS_ENABLED=false
OTP_INPUT_TIMEOUT_SECONDS=180
CHECKOUT_TIMEOUT_SECONDS=180
PAYMENT_HANDOFF_TTL_SECONDS=180
