# Terminal CLI settings. For the Telegram app, use .env.telegram.example instead.
POLL_INTERVAL=5
TARGET_PRODUCT="Perfect (R14) KB27"
TARGET_SIZE=185/65R14
TARGET_QUANTITY=2
HEADLESS=false
# Empty: Playwright Chromium. Use chrome for an existing Google Chrome install.
BROWSER_CHANNEL=
USER_DATA_DIR=./data/browser_profile
MAX_RETRIES=3
TIMEOUT_MS=15000
# Explicit HTTPS payment hosts; subdomains are allowed. Never use *.
GATEWAY_HOSTS=shaparak.ir
